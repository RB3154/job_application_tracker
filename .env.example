# Copy this file to .env and fill in real values.

DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# On AWS RDS, add ssl=require (not sslmode=require, which crashes the database driver):
# DATABASE_URL=postgresql://user:password@your-rds-endpoint:5432/job_tracker?ssl=require

# At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# AWS S3 settings for storing user uploaded profile pictures.
# Use the access key of an IAM user that can upload and delete files in the bucket's profile_pics/ folder.
# On AWS EC2, leave both S3 keys out and give the server an IAM role instead.
S3_BUCKET_NAME=your-bucket-name
S3_REGION=ap-southeast-2
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set only for S3-compatible services such as MinIO or R2
# S3_ENDPOINT_URL=

# Optional: largest profile picture upload allowed, in bytes (default 5 MB).
# MAX_UPLOAD_SIZE_BYTES=5242880

# Optional: default number of items per page for list endpoints (default 10).
# ITEMS_PER_PAGE=10

# Optional: how long a password reset token stays valid, in minutes (default 60).
# RESET_TOKEN_EXPIRE_MINUTES=60

# Email (SMTP) settings for password reset emails.
# For development, a free Mailtrap sandbox (https://mailtrap.io) catches the emails
# so nothing reaches a real inbox. Copy the SMTP credentials from your Mailtrap inbox.
MAIL_SERVER=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_USE_TLS=true

# Optional: base URL used in the reset link (default http://localhost:8000).
# FRONTEND_URL=http://localhost:8000

# Optional: send the login cookie only over HTTPS (default false). Set to true when deployed with HTTPS.
# Leave it false while the site is plain HTTP, or logging in won't work.
# COOKIE_SECURE=false

# Docker only: the timezone used for "today", because servers default to UTC.
# TZ=Asia/Kolkata
