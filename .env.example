# Copy this file to .env and fill in real values.

DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional: largest profile picture upload allowed, in bytes (default 5 MB).
# MAX_UPLOAD_SIZE_BYTES=5242880

# Optional: default number of items per page for list endpoints (default 10).
# ITEMS_PER_PAGE=10

# Optional: how long a password reset token stays valid, in minutes (default 60).
# RESET_TOKEN_EXPIRE_MINUTES=60

# Email (SMTP) settings for password reset emails.
# For development, a free Mailtrap sandbox (https://mailtrap.io) catches the emails
# so nothing reaches a real inbox. Copy the SMTP credentials from your Mailtrap inbox.
MAIL_SERVER=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_USE_TLS=true

# Optional: base URL used in the reset link (default http://localhost:8000).
# FRONTEND_URL=http://localhost:8000

# Optional: send the login cookie only over HTTPS (default false). Set to true when deployed with HTTPS.
# COOKIE_SECURE=false
